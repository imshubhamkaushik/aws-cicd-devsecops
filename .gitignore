# ============================================================================
# Secrets and local configuration. Never commit these.
# ============================================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.pem
*.key
*.p12
*.pfx
catalogix-key
catalogix-key.pub
.vault_pass
**/*password.txt

# Ansible Vault file created by scripts/python/aws/bootstrap.py (encrypted, but never commit it)
infra/ansible/group_vars/all/vault.yaml

# kubeconfig files written by the pipelines or by `aws eks update-kubeconfig`
kubeconfig
*.kubeconfig

# ============================================================================
# Terraform
# ============================================================================
# Keep .terraform.lock.hcl tracked: it pins provider versions.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
crash.log
crash.*.log
# Variable files can hold IPs, keys and account details. Only the .example files are tracked.
*.tfvars
*.tfvars.json
!*.tfvars.example
!terraform.tfvars.example

# ============================================================================
# Helm
# ============================================================================
# `helm template` output contains rendered Secrets.
*rendered*.yaml
# Downloaded chart dependencies; `helm dependency update` recreates them from Chart.lock.
infra/helm/**/charts/*.tgz

# ============================================================================
# Java / Maven
# ============================================================================
**/target/
*.jar
*.war
*.class
hs_err_pid*

# ============================================================================
# Node / frontend
# ============================================================================
**/node_modules/
**/build/
**/dist/
**/coverage/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# Python
# ============================================================================
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ============================================================================
# Scanners and local reports
# ============================================================================
.scannerwork/
.sonar/
.trivycache/

# ============================================================================
# Editors, OS, logs, scratch
# ============================================================================
.idea/
.vscode/
*.iml
*.project
*.classpath
*.settings/
.DS_Store
Thumbs.db
*.swp
*.log
*.tmp
.cache/
.tmp/
*.zip

# Tooling leftovers that are not part of this project
.github/modernize/
