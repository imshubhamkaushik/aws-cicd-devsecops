# ====== Java / Spring Boot ======
**/target/
*.jar
*.war
*.class
*.log

# ====== Node / React ======
**/node_modules/
**/build/
**/dist/
**/coverage/
# Local environment file with real secrets; copy from .env.example.
.env
**/.env
**/.env.*
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ====== Misc ======
**.zip
.github/

# ====== IDE / Editors ======
.idea/
.vscode/
*.iml
*.project
*.classpath
*.settings/

# TypeScript / build caches
*.tsbuildinfo
.eslintcache
.cache/
.tmp/

# Terraform
**/.terraform/
**/.terraform.lock.hcl

# Generated / local-only artifacts that must never be committed
__pycache__/
*.pyc

# `helm template` output contains rendered Secrets (random JWT/DB/RabbitMQ values)
catalogix-rendered.yaml
*rendered*.yaml

# Python tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

**/*password.txt

# Helm chart package files
helm/**/charts/*.tgz
# ====== Terraform ======
# Never commit variable files (may hold IPs, keys, account details) or state.
*.tfvars
*.tfvars.json
!*.tfvars.example
!terraform.tfvars.example
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
.terraform/
crash.log

# ====== Generated / local scratch ======
*rendered*.yaml
secrets/postgres_password.txt
