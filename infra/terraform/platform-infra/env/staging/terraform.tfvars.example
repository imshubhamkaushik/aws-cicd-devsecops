# Layer 2 (staging): a showcase of the multi-environment pattern. It is not kept
# in lockstep with dev (see the README), so expect to adjust it before using it.
# Copy to terraform.tfvars (gitignored).

aws_region   = "ap-south-1"
project_name = "catalogix"
cluster_name = "catalogix-cluster"   # the cluster becomes "<cluster_name>-staging"
environment  = "staging"

# Optional SMTP password for alert emails; keep it out of git, for example in
# smtp.auto.tfvars in this folder.
# smtp_password = "your-smtp-app-password"
