# Copy to .env before `docker compose up --build`. Never commit .env.

# ---- Postgres ----
# POSTGRES_* is the admin account of the local Postgres container.
# SERVICE_DB_PASSWORD is the password of the per-service roles (user_svc,
# catalog_svc, ...) created by postgres-init/01-create-databases.sh.
# Both are read only when the data volume is first created. After changing
# them, run `docker compose down -v` to recreate it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-admin
SERVICE_DB_PASSWORD=change-me-services

# ---- RabbitMQ ----
# Management UI: http://localhost:25672
RABBITMQ_USER=catalogix
RABBITMQ_PASSWORD=change-me-rabbit

# ---- JWT ----
# Shared signing key, at least 32 characters, identical for every service.
# Services refuse to start with the placeholder. Generate one with:
#   openssl rand -base64 48
# To rotate without logging everyone out, put the old key in
# JWT_SECRET_PREVIOUS for one token lifetime.
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# ---- CORS ----
# Only needed when calling a service without the gateway (for example the Vite
# dev server on :5173). Leave empty to disable CORS. Never "*" with credentials.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:11000

# ---- Notifications ----
MAIL_FROM=noreply@catalogix.local
# Base URL used for links inside emails (password reset, email verification).
FRONTEND_BASE_URL=http://localhost:11000

# Local admin login (set in docker-compose.yaml): admin@catalogix.local / AdminAdminAdmin
